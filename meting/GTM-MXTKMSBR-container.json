        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function () {\n  /* Staat de meting aan of uit in DEZE browser?\n\n     Geeft 'uit' of 'aan' terug. Drie bronnen, in deze volgorde:\n       1. ?meting=uit of ?meting=aan in het adres — die wint altijd, zodat de\n          eerste keer dat Sven het adres opent al niets meer meet, ook al heeft\n          de tag die het onthoudt op dat moment nog niet gelopen.\n       2. localStorage, dezelfde drager die de pagina zelf voor de\n          cookiekeuze gebruikt.\n       3. een gewone cookie, voor het geval localStorage dicht staat.\n\n     FAALT NAAR 'aan', met opzet. Gaat hier iets stuk, dan meet de pagina door\n     en zie je Svens eigen bezoeken in het rapport; dat is zichtbaar en te\n     herstellen. Zou dit naar 'uit' falen, dan stopt de hele meting zonder dat\n     iemand het merkt, en dat is de duurdere fout. */\n  var SLEUTEL = 'youbo-meting-uit';\n  var uitAdres = '';\n  try {\n    var m = String(location.search || '').match(/[?&]meting=([^&#]*)/);\n    uitAdres = m ? decodeURIComponent(m[1]).toLowerCase() : '';\n  } catch (e) { uitAdres = ''; }\n  if (uitAdres === 'uit') { return 'uit'; }\n  if (uitAdres === 'aan') { return 'aan'; }\n  try {\n    if (window.localStorage && localStorage.getItem(SLEUTEL) === '1') { return 'uit'; }\n  } catch (e2) {}\n  try {\n    if (('; ' + document.cookie).indexOf('; ' + SLEUTEL + '=1') > -1) { return 'uit'; }\n  } catch (e3) {}\n  return 'aan';\n}"
          }
