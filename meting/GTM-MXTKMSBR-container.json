        "name": "Uitschakelaar — onthoudt de keuze uit het webadres",
        "type": "html",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n  /* ONTHOUDT DE UITSCHAKELAAR VAN SVEN.\n\n     ?meting=uit  -> zet de vlag, in localStorage en in een cookie\n     ?meting=aan  -> wist hem\n     geen parameter en de vlag staat al -> de houdbaarheid verlengen\n\n     Dat verlengen is niet overbodig. Safari kapt een cookie die door\n     JavaScript gezet is af op zeven dagen, dus zou de uitschakelaar op zijn\n     iPhone na een week stil weer aangaan. Door hem bij elk bezoek opnieuw te\n     stempelen blijft hij staan zolang Sven de pagina af en toe opent.\n\n     Twee dragers naast elkaar, en met opzet: localStorage is wat de pagina\n     zelf voor de cookiekeuze gebruikt en overleeft het langst, de cookie is de\n     terugval voor een browser waarin localStorage dicht staat.\n\n     Deze tag meet niets en stuurt niets naar buiten. */\n  (function () {\n    var SLEUTEL = 'youbo-meting-uit';\n    var HOUDBAAR = 400 * 24 * 60 * 60;  /* 400 dagen; meer kapt Chrome af */\n\n    function stempel(waarde, seconden) {\n      try {\n        document.cookie = SLEUTEL + '=' + waarde + ';path=/;max-age=' + seconden\n          + ';SameSite=Lax' + (location.protocol === 'https:' ? ';Secure' : '');\n      } catch (e) {}\n    }\n    function zetUit() {\n      try { localStorage.setItem(SLEUTEL, '1'); } catch (e) {}\n      stempel('1', HOUDBAAR);\n    }\n    function zetAan() {\n      try { localStorage.removeItem(SLEUTEL); } catch (e) {}\n      stempel('', 0);\n    }\n\n    var vraag = '';\n    try {\n      var m = String(location.search || '').match(/[?&]meting=([^&#]*)/);\n      vraag = m ? decodeURIComponent(m[1]).toLowerCase() : '';\n    } catch (e) { vraag = ''; }\n\n    if (vraag === 'uit') { zetUit(); return; }\n    if (vraag === 'aan') { zetAan(); return; }\n\n    var staatUit = false;\n    try { staatUit = localStorage.getItem(SLEUTEL) === '1'; } catch (e) {}\n    if (!staatUit) {\n      try {\n        staatUit = ('; ' + document.cookie).indexOf('; ' + SLEUTEL + '=1') > -1;\n      } catch (e) {}\n    }\n    if (staatUit) { zetUit(); }\n  })();\n</script>"
          },
