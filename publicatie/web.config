<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config — de serverinstellingen voor demo.youbo.io.

  Deze pagina staat op Azure App Service op WINDOWS, dus achter IIS 10 en niet
  achter nginx. Vier dingen moeten hier geregeld worden; geen ervan regelt zich
  vanzelf, en drie ervan mislukken STIL — de bouw is groen en de pagina is stuk.

  1. MIME-TYPEN. IIS weigert elk bestandstype dat niet in zijn MIME-lijst
     staat, en antwoordt dan 404.3 — "niet gevonden" voor een bestand dat er
     wel degelijk staat. Van .webp is NIET te vinden of IIS 10 het standaard
     kent; de Microsoft-documentatie van <mimeMap> geeft geen lijst en de
     verhalen spreken elkaar tegen. Daarom staat elk type dat wij uploaden
     hieronder expliciet, met <remove> ervoor:

       - staat het al in applicationHost.config, dan zou een tweede regel
         "Cannot add duplicate collection entry of type mimeMap" opleveren en
         valt de hele site om met 500.19;
       - staat het er niet, dan is de <remove> een lege handeling.

     Zo is het goed in beide gevallen, en hoeven we niet te weten welk geval
     het is. publiceer.mjs controleert dat elk geüpload bestandstype hier ook
     echt staat, en stopt als dat niet zo is.

  2. /bedankt ZONDER .html. De bevestigingspagina staat als bedankt.html naast
     index.html in de wortel — met opzet, want dan blijven de relatieve paden
     naar assets/ kloppen. De mooie URL komt van de herschrijfregel onderaan.
     Die leunt op de IIS-module URL Rewrite; op App Service voor Windows is
     die voorgeïnstalleerd. Is hij er onverhoopt niet, dan geeft de HELE
     web.config 500.19 — dus dat is bij de eerste publicatie het eerste wat je
     controleert.

  3. EEN STANDAARDDOCUMENT, anders geeft de wortel een mappenlijst of 403.

  4. CACHEKOPPEN. Gemeten op 2026-10-09: www.youbo.io stuurt op geen enkele
     respons een Cache-Control. Elke bezoeker haalt elke foto elke keer
     opnieuw op. Die fout maken we hier niet.

       - assets/  : 30 dagen. NIET een jaar en NIET "immutable": de
                    bestandsnamen dragen geen versiehash, dus een vervangen
                    foto zou een jaar lang niet aankomen bij wie de pagina al
                    bezocht heeft. Komt er ooit een hash in de naam, dan mag
                    dit naar een jaar.
       - de rest  : no-cache. De twee HTML-bestanden MOETEN meteen vernieuwen,
                    want het hele punt van de pijplijn is dat een FAQ-antwoord
                    uit het CMS binnen enkele minuten te zien is. no-cache
                    betekent "elke keer navragen", niet "nooit bewaren": met
                    de ETag die IIS meestuurt is dat een goedkope 304.
-->
<configuration>
  <system.webServer>

    <!-- 3. De wortel toont index.html. <clear/> zodat de erfenis van
         App Service (Default.htm, iisstart.htm, …) niet meespeelt. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- 1. Elk type dat publiceer.mjs mag uploaden. Zie de nota hierboven
           voor waarom er een <remove> voor elke regel staat. -->
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".png" />
      <mimeMap fileExtension=".png" mimeType="image/png" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="text/xml" />

      <!-- 4. De basisregel: niets bewaren zonder navragen. assets/ krijgt
           hieronder een eigen, langere regel. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- Hun eigen site stuurt deze ook; pariteit houden kost niets. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- App Service zet X-Powered-By: ASP.NET op elke respons. Dat vertelt
             een voorbijganger welke stack hier draait en doet verder niets. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Het boekhoudbestand van de upload-actie (welke bestanden met
               welke hash al op de server staan). Het hoort bij de pijplijn,
               niet bij de site, en het hoeft dus niet publiek opvraagbaar te
               zijn. IIS antwoordt hierop 404. web.config zelf zit al in de
               standaardlijst van IIS. -->
          <add segment=".ftp-deploy-sync-state.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- 2. /bedankt en /bedankt/ tonen bedankt.html, zonder dat de URL in
             de adresbalk verandert. Een Rewrite, geen Redirect. De regel kan
             zichzelf niet opnieuw raken: "bedankt.html" past niet op
             ^bedankt/?$ . De querystring blijft staan (appendQueryString is
             standaard aan), zodat ?utm_… overleeft. -->
        <rule name="bedankt zonder extensie" stopProcessing="true">
          <match url="^bedankt/?$" />
          <action type="Rewrite" url="/bedankt.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- 4. De uitzondering voor de afbeeldingen. Specifieker dan de regel in de
       wortel, dus deze wint voor alles onder assets/. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
